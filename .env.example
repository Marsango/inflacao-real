# Local development settings. Copy to .env and set your own password.
POSTGRES_DB=inflacao_real
POSTGRES_USER=inflacao_real
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_PORT=5432

# Core API: bind a unique, secret token to one scraper and its allowed shop IDs.
HTTP_ADDR=127.0.0.1:8080
INGESTION_TOKEN=replace-with-a-long-random-token
INGESTION_SCRAPER_ID=collector-sp-01
# Comma-separated shop IDs.
INGESTION_SHOP_IDS=mercado-exemplo

# Ingestion worker. Shops must also be registered in the database.
INGESTION_POLL_INTERVAL=1m
INGESTION_BATCH_SIZE=100
INGESTION_MAX_ATTEMPTS=5
INGESTION_RETRY_BASE=1m
INGESTION_RETRY_MAX=1h
