{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inflacao-real:ingestion:v1",
  "title": "Inflação Real scraper ingestion v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "submission_id", "scraper_id", "shop_id", "run_id", "created_at", "collector", "observations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "submission_id": {"$ref": "#/$defs/uuid"},
    "scraper_id": {"$ref": "#/$defs/slug"},
    "shop_id": {"$ref": "#/$defs/slug"},
    "run_id": {"$ref": "#/$defs/uuid"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "collector": {"$ref": "#/$defs/collector"},
    "observations": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/observation"}}
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "slug": {
      "type": "string", "minLength": 1, "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
      "not": {"pattern": "\\s"}
    },
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "url": {
      "type": "string", "format": "uri", "maxLength": 4096,
      "pattern": "^https?://[^/?#\\s]+(?:[/?#][^\\s]*)?$"
    },
    "sourceId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "label": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
    "money": {
      "description": "Nonnegative BRL amount, exactly two decimal places; no float, separators, or exponent.",
      "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,8})\\.[0-9]{2}$",
      "not": {"pattern": "\\s"}
    },
    "quantity": {
      "description": "Positive decimal, up to six fractional digits; canonical form has no trailing fractional zeros.",
      "type": "string", "maxLength": 16,
      "pattern": "^(?:[1-9][0-9]{0,8}(?:\\.[0-9]{0,5}[1-9])?|0\\.[0-9]{0,5}[1-9])$",
      "not": {"pattern": "\\s"}
    },
    "nullableLabel": {"anyOf": [{"$ref": "#/$defs/label"}, {"type": "null"}]},
    "nullableSourceId": {"anyOf": [{"$ref": "#/$defs/sourceId"}, {"type": "null"}]},
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["quantity", "unit", "count"],
      "properties": {
        "quantity": {"$ref": "#/$defs/quantity"},
        "unit": {"enum": ["g", "kg", "ml", "l", "unit"]},
        "count": {"type": "integer", "minimum": 1, "maximum": 100000}
      }
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["source_product_id", "name", "brand", "gtin", "package"],
      "properties": {
        "source_product_id": {"$ref": "#/$defs/sourceId"},
        "name": {"$ref": "#/$defs/label"},
        "brand": {"$ref": "#/$defs/nullableLabel"},
        "gtin": {"anyOf": [{"type": "string", "pattern": "^(?:[0-9]{8}|[0-9]{12}|[0-9]{13}|[0-9]{14})$", "not": {"pattern": "\\s"}}, {"type": "null"}]},
        "package": {"anyOf": [{"$ref": "#/$defs/package"}, {"type": "null"}]}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["seller_id", "store_id", "postal_code", "city", "state", "channel"],
      "properties": {
        "seller_id": {"$ref": "#/$defs/nullableSourceId"},
        "store_id": {"$ref": "#/$defs/nullableSourceId"},
        "postal_code": {"anyOf": [{"type": "string", "minLength": 8, "maxLength": 8, "pattern": "^[0-9]{8}$"}, {"type": "null"}]},
        "city": {"$ref": "#/$defs/nullableLabel"},
        "state": {"enum": [null, "AC", "AL", "AP", "AM", "BA", "CE", "DF", "ES", "GO", "MA", "MT", "MS", "MG", "PA", "PB", "PR", "PE", "PI", "RJ", "RN", "RS", "RO", "RR", "SC", "SP", "SE", "TO"]},
        "channel": {"enum": ["delivery", "pickup", "online", "unknown"]}
      }
    },
    "conditions": {
      "type": "object", "additionalProperties": false,
      "required": ["payment_method", "installments", "membership_required", "membership_program", "coupon_required", "minimum_quantity", "description"],
      "properties": {
        "payment_method": {"enum": ["any", "pix", "cash", "debit_card", "credit_card", "boleto", "other", "unknown"]},
        "installments": {"type": ["integer", "null"], "minimum": 1, "maximum": 120},
        "membership_required": {"type": ["boolean", "null"]},
        "membership_program": {"$ref": "#/$defs/nullableLabel"},
        "coupon_required": {"type": ["boolean", "null"]},
        "minimum_quantity": {"anyOf": [{"$ref": "#/$defs/quantity"}, {"type": "null"}]},
        "description": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"installments": {"type": "integer"}}}, "then": {"properties": {"payment_method": {"const": "credit_card"}}}},
        {"if": {"properties": {"membership_required": {"const": false}}}, "then": {"properties": {"membership_program": {"type": "null"}}}}
      ]
    },
    "offer": {
      "type": "object", "additionalProperties": false,
      "required": ["amount", "currency", "basis", "reference_amount", "conditions"],
      "properties": {
        "amount": {"$ref": "#/$defs/money"},
        "currency": {"const": "BRL"},
        "basis": {"enum": ["package", "kg", "l", "unit"]},
        "reference_amount": {"anyOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]},
        "conditions": {"$ref": "#/$defs/conditions"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "observed_at", "collection_method", "source_url", "product_url", "product", "context", "availability", "offers"],
      "properties": {
        "observation_id": {"$ref": "#/$defs/uuid"},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "collection_method": {"enum": ["api", "html", "browser"]},
        "source_url": {"$ref": "#/$defs/url"},
        "product_url": {"$ref": "#/$defs/url"},
        "product": {"$ref": "#/$defs/product"},
        "context": {"$ref": "#/$defs/context"},
        "availability": {"enum": ["in_stock", "out_of_stock", "unknown"]},
        "offers": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/offer"}}
      }
    },
    "collector": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"$ref": "#/$defs/slug"}, "version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"}}
    }
  }
}
